# Copia esto a .env (nunca subas .env — ya está en .gitignore) para probar en tu compu.
# En Vercel, estas mismas dos variables se ponen en Settings → Environment Variables,
# nunca en el código ni en git.

# Settings → API → Project URL, en tu proyecto de Supabase
SUPABASE_URL=

# Settings → API → Project API keys → "service_role" (la secreta, NO la "anon public")
# Esta llave puede leer y escribir TODO sin importar el candado de RLS.
# Nunca la pongas en el HTML ni en ningún archivo que suba a GitHub.
SUPABASE_SERVICE_ROLE_KEY=
